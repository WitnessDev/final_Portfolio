rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reads for published content, admin-only writes.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Photos
    match /photos/{photoId} {
      allow read: if resource.data.published == true || true; // public read (adjust if needed)
      allow create, update, delete: if isAdmin();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if resource.data.published == true || true;
      allow create, update, delete: if isAdmin();
    }

    // Videos
    match /videos/{videoId} {
      allow read: if resource.data.published == true || true;
      allow create, update, delete: if isAdmin();
    }

    // Songs
    match /songs/{songId} {
      allow read: if resource.data.published == true || true;
      allow create, update, delete: if isAdmin();
    }
  }
}
