rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
